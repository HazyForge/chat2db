<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p --- [%15.15t] %-40.40logger{39} : %X{TRACE_ID} | %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <logger name="ai.chat2db.community.web.api.config.log.EasyLogSink" level="OFF"/>
    <logger name="ai.chat2db.community.web.api.adapter.ai.AiChatStreamAdapter" level="OFF"/>
    <logger name="ai.chat2db.community.web.api.adapter.ai.WebClientParameterFilter" level="OFF"/>
    <logger name="ai.chat2db.community.web.api.adapter.ai.ZoerClientHttpRequestInterceptor" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
